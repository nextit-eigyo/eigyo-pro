{
  // ───────────────────────────────────────────────────────────────
  //  EIGYO PRO — Firebase Realtime Database セキュリティルール
  // ───────────────────────────────────────────────────────────────
  //  ⚠ このファイルは「記録・参照用」です。保存しただけでは反映されません。
  //     実際に効かせるには Firebase コンソールの Realtime Database →
  //     「ルール」タブに貼り付けて「公開」する必要があります。
  //     (または Firebase CLI: firebase deploy --only database)
  //
  //  目的: 「URLを知っていれば誰でも読み書きできる」状態をやめ、
  //         アプリにメールでログインできる人だけに限定する。
  //
  //  安全性: このアプリは
  //    ・匿名認証を廃止済み(誰でも通過できる穴を塞いである)
  //    ・メール+パスワード認証のみ
  //    ・アプリからの新規アカウント登録なし(管理者がコンソールで作成)
  //    ・会社全体で1つの共有データを全営業が読み書きする設計
  //  のため、下記 auth != null ルールでも既存の同期は壊れません。
  // ───────────────────────────────────────────────────────────────
  "rules": {
    // 【採用中】ログイン済み(メール認証)ユーザーのみ 全データ読み書き可。
    //  これだけで「URLを知る第三者の読み書き」を完全に遮断できる。
    ".read": "auth != null",
    ".write": "auth != null"

    // ───────────────────────────────────────────────────────────────
    //  【さらに強固にしたい場合・任意】なりすまし新規登録も封じる版。
    //  公開APIキーで攻撃者が勝手にアカウントを作っても、許可リストに
    //  載っていなければ一切アクセスできなくする。切り替える手順:
    //    1) Firebaseコンソール → Authentication → Users で
    //       各営業の「ユーザーUID」を控える
    //    2) Realtime Database に  /allowedUsers/<UID> = true  を人数分登録
    //    3) 上の .read / .write を下記に差し替え:
    //
    //    ".read":  "root.child('allowedUsers').child(auth.uid).val() === true",
    //    ".write": "root.child('allowedUsers').child(auth.uid).val() === true",
    //    "allowedUsers": { ".write": false }
    //
    //  ⚠ 自分のUIDを入れ忘れると全員アクセス不可になる(データは消えないが
    //     同期が止まる)。全営業のUID登録を確認してから切り替えること。
    // ───────────────────────────────────────────────────────────────
  }
}
